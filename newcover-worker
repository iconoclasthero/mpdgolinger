#!/bin/bash
# shellcheck disable=SC2016

shopt -s extglob

uri="$1"
dir="$2"


[[ ! -d "$dir" || ! -w "$dir" ]] &&
  { printf '[ERROR] Destination dir `%s` does not exist or is not writable; investigate! (exit 1)\n' "$dir" >&2; exit 1; }

cd "$dir" || { printf '[ERROR] Unable to `cd %s`; investigate! (exit 1)\n' "$dir" >&2; exit 1; }

[[ -w "${PWD}" ]] || { printf '[ERROR] Unable to write to PWD; investigate! (exit 1)\n        PWD:%s\n' "$dir" >&2; exit 1; }

## for permissions later:
umask 022
newfiles=( 'cover.jpg' 'cover-1500.jpg' 'cover-500.jpg' )

: "${target:=1500}"
: "${small:=500}"
: "${minpx:=1000000}"
: "${minbpp:=1}"
: "${upscaler:=web}"
: "${model:=/opt/repicturer/models-realesrgan-x4plus}"
: "${mediagrp:=media}"
: "${ext:=jpg}"

for cmd in axel ffmpeg; do
  command -v "$cmd" >/dev/null ||
    { printf '[ERROR] Handler `%s` not found; install. (exit 1)\n' "$cmd"; exit 1; }
done

mp42webp(){
  local ec
  local newfiles=( cover.webp )
  if ffmpeg -nostdin -y -i cover.mp4 -vf "colorspace=all=bt601-6-625:ispace=bt709:iprimaries=bt709:itrc=bt709,fps=15" \
       -colorspace 6 -color_primaries 6 -color_trc 6 -quality 85 -loop 0 cover.webp 2>&1; then
    ec='0'
  else
    ec="$?"
    printf '[ERROR] Converstion of cover.mp4 to cover.webp exited with an error. (exit %s)\n' "$ec"
  fi

  ## cleanup regardless of success, can always redownload the .mp4:
  rm cover.mp4 "$tmpcvr"

  chgrp "$mediagrp" "${newfiles[@]}" || { printf '[ERROR] Failed to change group to %s. (exit 1)\n' "$mediagrp" >&2; ec=1; }
  chmod g+rw "${newfiles[@]}" || { printf '[ERROR] Failed to change group permissions to g+rw. (exit 1)\n' >&2; ec=1; }
  [[ -f cover.jpg || -f cover.png ]] &&
    printf '[WARN] The newly-generated cover.webp will not be displayed because there is an existing cover.png/jpg.\n' >&2

  return "$ec"
}

## unwrap the `file:` URIs:
[[ "$uri" =~ ^file:(//)?(.+) ]] && uri="${BASH_REMATCH[2]}"

## check uri for the specail case of an .mp4
[[ "$uri" = *.mp4 ]] && mp4='1' ext='mp4'

tmpcvr="$(mktemp -up . -t "cover.$ext-XXXXXXX")"

if [[ "$uri" = http@(|s)://* ]]; then
  axel "$uri" -o "$tmpcvr" || {
     printf 'Download of cover from failed; URI:\n  %s\n(exit 1)\n' "$uri" >&2
     rm "$tmpcvr"
     exit 1
  }

  if [[ -f 'cover.jpg' ]]; then
    printf -v TS '%(%Y%m%d-%H%M%S)T'
    mv cover.jpg "cover-mgl-$TS.jpg" ||
      { printf 'Failed to back up existing cover.jpg; investigate. (exit 1)\n' >&2; exit 1; }
  fi

  mv "$tmpcvr" "cover.$ext"

elif [[ -f "$uri" ]]; then
  uri="$(realpath -- "$uri")"
  printf -v TS '%(%Y%m%d-%H%M%S)T'
  if [[ "$uri" != "$PWD/cover.jpg"  && -f 'cover.jpg'  ]]; then
    mv cover.jpg "cover.jpg-$TS"

    if (( mp4 )); then
      mv "$uri" "cover.$ext"
    else
      ## this copies the existing file so it's not destroyed.  can change back to mv:
      # mv "$uri" "cover.$ext"
      cp "$uri" "cover.$ext"
    fi

  elif [[ "$uri" = "$PWD/cover.jpg"  && -f 'cover.jpg'  ]]; then
    cp -a cover.jpg "cover.jpg-$TS"
  elif (( mp4 )); then
    mv "$uri" "cover.$ext"
  else
    cp "$uri" "cover.$ext"
  fi

else
  printf 'Invalid cover URL or file: URI (file not found or unsupported URI format): %s (exit 1)\n' "$uri" >&2
  exit 1
fi

if (( mp4 )); then
  mp42webp
  exit "$?"
fi

if [[ -f "$PWD/cover.jpg" ]]; then
  [[ -w "$PWD/cover.jpg" ]] ||
    { printf '[ERROR] `cover.jpg` is not writable (%s); investigate! (exit 1)\n' "$PWD" >&2; exit 1; }
fi

read -r w h < <(identify -ping -format '%w %h\n' cover.jpg) ||
  { printf '[ERROR] Failed to `identify cover.jpg`; investigate. (exit 1)\n' >&2; exit 1; }
b=$(stat -c %s -- cover.jpg) ||
    { printf '[ERROR] Failed to `stat cover.jpg`; investigate. (exit 1)\n' >&2; exit 1; }

p=$((w * h))
d=$((w < h ? w : h))

if (( d >= target )); then
  printf 'No upscale: %sx%s, %s bytes\n' "$w" "$h" "$b"
  magick cover.jpg -resize "${target}x${target}^" -quality 80 cover-1500.jpg ||
    { printf 'magic -resize to %sx%s^ failed. (exit 1)\n' "$target" "$target" >&2; exit 1; }

elif (( p >= minpx && b >= p * minbpp )); then
  printf 'Lanczos: %sx%s, %s bytes\n' "$w" "$h" "$b"

## we want no side < 1500!
## why are we even calculating this?! let magick handle it.
#  if (( w >= h )); then
#    ow="$target"
#    oh=$((h * target / w))
#  else
#    oh="$target"
#    ow=$((w * target / h))
#  fi
#
#  magick cover.jpg -filter Lanczos -resize "${ow}x${oh}!" \
#    -quality 80 cover-1500.jpg || exit 1

  magick cover.jpg -filter Lanczos -resize "${target}x${target}^" \
      -quality 80 cover-1500.jpg ||
    { printf '[ERROR] Inexplicably, magick failed to convert the image; investigate. (exit 1)\n' >&2; exit 1; }

else
  printf 'AI upscale: %sx%s, %s bytes\n' "$w" "$h" "$b"

upscaler-local(){
  command -v repicturer-cli >/dev/null ||
    { printf '[ERROR] Handler `repicturer-cli` not found; install. (exit 1)\n' >&2; exit 1; }

  [[ -d "$model" ]] ||
    { printf '[ERROR] Model directory `%s` not found; investigate. (exit 1)\n' "$model" >&2; exit 1; }

  ## we want no side < 1500!
  if (( w <= h )); then
    ow="$target"
    oh=$((h * target / w))
  else
    oh="$target"
    ow=$((w * target / h))
  fi

  ## this is dumping it's processing output to stderr. this is a problem because it's not relevant
  ## to the error that I need to propigate to the front end.
  repicturer-cli -i cover.jpg -o cover-1500-ai.png \
      -M scale -m "$model" -W "$ow" -H "$oh" -v 2>&1 ||
    { ec="$?"; printf '[ERROR] repicture-cli failed with exit code %s; investigate. (exit %s)\n' "$ec" "$ec" >&2; exit "$ec"; }

  magick cover-1500-ai.png -quality 80 cover-1500.jpg ||
    { printf '[ERROR] magick failed to create the 1500² .jpg; investigate. (exit 1)\n' >&2; exit 1; }
  rm cover-1500-ai.png
}

  if [[ "$upscaler" = web ]]; then
    command -v node >/dev/null ||
      { printf '[ERROR] Node.js not found; install it. (exit 1)\n' >&2; exit 1; }
    scale=2
    (( d * scale < target )) && scale=4

    if (( d * scale >= target )); then
      node /opt/newcover-worker/upscale.mjs cover.jpg "$scale" cover-1500-ai.jpg ||
        { ec="$?"; printf '[ERROR] ImgUpscaler helper failed with exit code %s. (exit %s)\n' "$ec" "$ec" >&2; exit "$ec"; }

      magick cover-1500-ai.jpg -quality 80 cover-1500.jpg ||
        { printf '[ERROR] magick failed to create cover-1500.jpg from ImgUpscaler output. (exit 1)\n' >&2; exit 1; }
      rm cover-1500-ai.jpg
    else
      printf '[WARN] The source image is <%s/4² and cannot meet the %s² target with the %s upscaler; falling back to local model.\n' "$target" "$target"
      upscaler-local
    fi
  elif [[ "$upscaler" = local ]]; then
    upscaler-local
  else
    printf '[ERROR] Unsupported upscaler `%s`; use web or local. (exit 1)\n' "$upscaler" >&2
    exit 1
  fi
fi

printf 'Starting creation of 500² cover\n$small=%s\n\n\n' "$small"

#magick cover.jpg -resize "${small}x${small}" \
magick cover.jpg -resize "${small}x${small}^" \
  -quality 80 cover-500.jpg ||
    { printf '[ERROR] magick failed to create the 500² .jpg; investigate. (exit 1)\n.' >&2; exit 1; }

ln -f cover-1500.jpg cover.jpg

chgrp "$mediagrp" "${newfiles[@]}" || { printf '[ERROR] Failed to change group to %s. (exit 1)\n' "$mediagrp" >&2; ec=1; }
chmod g+rw "${newfiles[@]}" || { printf '[ERROR] Failed to change group permissions to g+rw. (exit 1)\n' >&2; ec=1; }

[[ -f cover.png ]] && printf '[WARN] The newly-generated cover.jpg will not be displayed because there is an existing cover.png.\n' >&2

exit "${ec:=0}"


